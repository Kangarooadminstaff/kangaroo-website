{
  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": [
      "/assets/*",
      "/icons/*",
      "/api/*"
    ]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "routes": [
    {
      "route": "/login",
      "redirect": "https://pouch.groupkangaroo.com/",
      "statusCode": 302
    },
    {
      "route": "/connexion",
      "redirect": "https://pouch.groupkangaroo.com/",
      "statusCode": 302
    },
    {
      "route": "/assets/*",
      "headers": {
        "cache-control": "public, max-age=86400"
      }
    }
  ],
  "platform": {
    "apiRuntime": "node:20"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "SAMEORIGIN",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
  }
}